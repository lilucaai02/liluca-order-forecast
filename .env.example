# Amazon SP-API Credentials (共通 - 全アカウントで共有)
LWA_APP_ID=
LWA_CLIENT_SECRET=

# レガシー互換 (単一アカウント時はこれだけでOK)
SP_API_REFRESH_TOKEN=

# マルチアカウント設定 (最大5アカウント)
# ACCOUNT_1_NAME=coconem
# ACCOUNT_1_REFRESH_TOKEN=Atzr|...
# ACCOUNT_2_NAME=kk-trading
# ACCOUNT_2_REFRESH_TOKEN=Atzr|...
# ACCOUNT_3_NAME=bulqrea
# ACCOUNT_3_REFRESH_TOKEN=Atzr|...

# 楽天RMS認証情報 (最大3アカウント)
# RMS管理画面 > API設定 から取得
# RAKUTEN_1_NAME=my-rakuten-shop
# RAKUTEN_1_SERVICE_SECRET=
# RAKUTEN_1_LICENSE_KEY=
# RAKUTEN_2_NAME=
# RAKUTEN_2_SERVICE_SECRET=
# RAKUTEN_2_LICENSE_KEY=

# AWS Credentials (optional for LWA-only auth)
SP_API_ACCESS_KEY=
SP_API_SECRET_KEY=
SP_API_ROLE_ARN=

# Marketplace
MARKETPLACE=JP

# Sandbox mode (true=サンドボックスAPI, false=本番API)
SANDBOX_MODE=true

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=

# Google Sheets (optional)
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SPREADSHEET_ID=

# Monitoring
CHECK_INTERVAL_MINUTES=60
ALERT_COOLDOWN_HOURS=24
